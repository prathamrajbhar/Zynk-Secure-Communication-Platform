# ============================================================================
# Zynk Production Environment Template
#
# Copy this file to .env and fill in all values.
# NEVER commit the actual .env file to version control.
#
# Required values are marked with (REQUIRED)
# ============================================================================

# ======================== Server ========================
NODE_ENV=production
PORT=8000
LOG_LEVEL=info

# ======================== Database (REQUIRED) ========================
DATABASE_URL=postgresql://zynk:STRONG_PASSWORD_HERE@postgres:5432/zynk?sslmode=require
DB_POOL_MAX=30
DB_POOL_MIN=5

# ======================== Redis (REQUIRED) ========================
REDIS_URL=redis://:REDIS_PASSWORD_HERE@redis:6379

# ======================== JWT Secrets (REQUIRED) ========================
# Generate with: openssl rand -hex 64
JWT_SECRET=CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_HEX_64
JWT_REFRESH_SECRET=CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_HEX_64
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ======================== CORS (REQUIRED) ========================
CORS_ORIGIN=https://zynk.example.com

# ======================== Security ========================
BCRYPT_ROUNDS=12
MIN_PASSWORD_LENGTH=8
MAX_DEVICES=5
SESSION_EXPIRY_MS=900000
REFRESH_EXPIRY_MS=604800000

# ======================== Rate Limiting ========================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX_LOGIN=5
AUTH_RATE_LIMIT_MAX_REGISTER=3

# ======================== File Uploads ========================
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=52428800
BODY_LIMIT=2mb

# ======================== TURN/STUN (WebRTC) ========================
TURN_URLS=turn:turn.example.com:3478
TURN_USERNAME=
TURN_CREDENTIAL=
STUN_URLS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302

# ======================== Call Settings ========================
CALL_RING_TIMEOUT_MS=30000
CALL_MAX_DURATION_SECS=3600

# ======================== Push Notifications (Optional) ========================
# FCM_SERVER_KEY=
# FCM_PROJECT_ID=
# APNS_KEY_ID=
# APNS_TEAM_ID=

# ======================== CDN (Optional) ========================
# CDN_URL=https://cdn.zynk.example.com
# CDN_BUCKET=zynk-media
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=us-east-1

