// ======================== Double Ratchet Session State ========================

/// Double Ratchet session state — stores per-conversation ratchet chains
/// Enables forward secrecy (past messages safe) and future secrecy (self-healing)
/// Used in: Signal Protocol message encryption/decryption, session management
model RatchetSession {
  id                    String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id               String   @db.Uuid
  peer_id               String   @db.Uuid
  conversation_id       String   @db.Uuid
  
  // Ratchet state - KDF chains for message key derivation
  root_key              String   // Current root key (base64) - ratcheted on DH step
  sending_chain_key     String?  // Current sending chain key (base64)
  receiving_chain_key   String?  // Current receiving chain key (base64)
  sending_chain_n       Int      @default(0) // Sending chain message number
  receiving_chain_n     Int      @default(0) // Receiving chain message number
  previous_chain_n      Int      @default(0) // Previous sending chain length (for header)
  
  // DH ratchet keys - rotated on each message exchange
  dh_public_key         String   // Our current DH public key (base64)
  dh_private_key        String   // Our current DH private key (base64)
  peer_dh_public_key    String?  // Peer's current DH public key (base64)
  
  // Skipped message keys - for out-of-order message decryption
  // Format: { "dh_public_key:message_number": "message_key_base64" }
  skipped_message_keys  Json     @default("{}")
  
  // Session metadata
  created_at            DateTime @default(now()) @db.Timestamp(6)
  updated_at            DateTime @default(now()) @updatedAt @db.Timestamp(6)
  
  // Relations
  user         User         @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  peer         User         @relation("PeerSessions", fields: [peer_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  conversation Conversation @relation(fields: [conversation_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  
  @@unique([user_id, peer_id, conversation_id])
  @@map("ratchet_sessions")
  @@index([user_id, conversation_id], map: "idx_ratchet_sessions_user_conv")
  @@index([updated_at], map: "idx_ratchet_sessions_updated")
}
